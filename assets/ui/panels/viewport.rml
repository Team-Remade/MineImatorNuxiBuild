<rml>
<head>
    <link type="text/rcss" href="../styles/menubar.rcss"/>
</head>
<body class="panel-document">
    <div class="workspace-layer">
        <div class="left-column panel-column">
            <div id="viewport-panel" class="editor-panel">
                <div class="panel-header">
                    <div class="panel-header-left">
                        <button id="spawn-menu-btn" class="spawn-menu-btn" title="Spawn Menu">
                            <img src="../../img/bench.png" class="spawn-menu-icon" alt="Spawn Menu"/>
                        </button>
                        <span>3D Viewport</span>
                    </div>
                    <span class="panel-meta">Perspective</span>
                </div>
                <div id="viewport-surface"></div>
            </div>
        </div>
    </div>
</body>
</rml>

<rml>
<head>
    <link type="text/rcss" href="../styles/menubar.rcss"/>
</head>
<body class="panel-document">
    <div class="workspace-layer">
        <div class="right-column panel-column">
            <div id="scene-tree-panel" class="editor-panel">
                <div class="panel-header">
                    <span>Scene Tree</span>
                </div>
                <div class="scene-tree">
                    <div class="scene-tree-search-box">
                        <span class="scene-tree-search-icon">&#128269;</span>
                        <input type="text" id="scene-tree-search" class="scene-tree-search" placeholder="Search scene objects..."/>
                    </div>
                    <div id="scene-tree-items" class="scene-tree-items"></div>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>

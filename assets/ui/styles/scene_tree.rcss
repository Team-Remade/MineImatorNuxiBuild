body { width: 100%; height: 100%; margin: 0; font-family: "Noto Sans"; color: #f2f5ff; background-color: transparent; overflow: hidden; }
.workspace-layer { position: absolute; top: 30dp; right: 0; bottom: 0; left: 0; pointer-events: none; }
.right-column { position: absolute; top: 0; right: 0; bottom: 0; width: 25%; }
#scene-tree-panel { position: absolute; top: 0; right: 0; left: 0; height: 30%; background-color: #171d2a; border: 1dp #35405a; pointer-events: auto; }
.panel-header { box-sizing: border-box; height: 28dp; padding: 5dp 9dp; display: flex; flex-direction: row; justify-content: space-between; align-items: center; background-color: #20283a; border-bottom: 1dp #35405a; color: #f0f3fb; font-size: 12dp; }
.panel-action { padding: 0 5dp; color: #9db8ff; font-size: 16dp; }
.scene-tree { padding: 6dp; }
.tree-row { padding: 5dp 7dp; color: #c7cede; font-size: 12dp; }
.tree-child { padding-left: 25dp; }
.tree-root { color: #eef2fb; }
.tree-row.selected { background-color: #31466f; color: #ffffff; border-radius: 3dp; }

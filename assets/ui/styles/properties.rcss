body { width: 100%; height: 100%; margin: 0; font-family: "Noto Sans"; color: #f2f5ff; background-color: transparent; overflow: hidden; }
.workspace-layer { position: absolute; top: 30dp; right: 0; bottom: 0; left: 0; pointer-events: none; }
.right-column { position: absolute; top: 0; right: 0; bottom: 0; width: 25%; }
.scene-tree-spacer { display: none; }
#properties-panel { position: absolute; right: 0; bottom: 0; left: 0; height: 70%; background-color: #171d2a; border: 1dp #35405a; pointer-events: auto; }
.panel-header { box-sizing: border-box; height: 28dp; padding: 5dp 9dp; background-color: #20283a; border-bottom: 1dp #35405a; color: #f0f3fb; font-size: 12dp; }
.properties-content { padding: 7dp; }
.property-section { margin-top: 6dp; padding: 6dp 5dp; background-color: #1d2535; border-bottom: 1dp #3c4964; color: #dce3f2; font-size: 11dp; }
.property-row { display: flex; flex-direction: row; justify-content: space-between; padding: 7dp 5dp; border-bottom: 1dp #242d3f; color: #9da8bc; font-size: 11dp; }
.property-value { color: #d7deec; }

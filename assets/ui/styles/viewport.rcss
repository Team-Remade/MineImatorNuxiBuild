body {
    width: 100%;
    height: 100%;
    margin: 0;
    font-family: "Noto Sans";
    color: #f2f5ff;
    background-color: transparent;
    overflow: hidden;
}

.workspace-layer {
    position: absolute;
    top: 30dp;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
}

.left-column {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 75%;
}

#viewport-panel {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 70%;
    border: 1dp #35405a;
    background-color: transparent;
    pointer-events: auto;
}

.panel-header {
    box-sizing: border-box;
    height: 28dp;
    padding: 5dp 9dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: #20283a;
    border-bottom: 1dp #35405a;
    color: #f0f3fb;
    font-size: 12dp;
}

.panel-meta {
    color: #8792aa;
    font-size: 10dp;
}

#viewport-surface {
    position: absolute;
    top: 28dp;
    right: 0;
    bottom: 0;
    left: 0;
}

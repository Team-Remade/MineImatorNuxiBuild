body {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: "Noto Sans";
    color: #f2f5ff;
    background-color: transparent;
    pointer-events: none;
    box-sizing: border-box;
}

#menubar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 30dp;
    background-color: #121826;
    border-bottom: 1dp #2f3a56;
    z-index: 100;
    pointer-events: auto;
    box-sizing: border-box;
}

#menu-items {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    margin: 0 8dp;
    height: 100%;
}

.menu-item {
    display: inline-block;
    padding: 5dp 8dp;
    border-radius: 4dp;
    font-size: 13dp;
    position: relative;
}

.menu-item:hover {
    background-color: #3a4a78;
}

.menu-item-group {
    cursor: default;
}

.dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200dp;
    padding: 4dp 0;
    background-color: #232b3d;
    border: 1dp #384563;
    z-index: 20;
}

.menu-item-group.open .dropdown-menu {
    display: block;
}

.dropdown-item {
    display: block;
    padding: 6dp 10dp;
    font-size: 12dp;
}

.dropdown-item:hover {
    background-color: #3a4a78;
}

.dropdown-item-with-separator {
    border-bottom: 1dp #384563;
    margin-bottom: 2dp;
    padding-bottom: 7dp;
}

.panel-document {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: transparent;
    pointer-events: none;
    box-sizing: border-box;
}

.workspace-layer {
    position: absolute;
    top: 30dp;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: row;
    pointer-events: none;
    box-sizing: border-box;
}

.panel-column {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    min-height: 0;
    box-sizing: border-box;
}

.left-column {
    width: 75%;
}

.right-column {
    width: 25%;
    margin-left: 75%;
}

.editor-panel {
    position: relative;
    min-width: 0;
    min-height: 0;
    background-color: #171d2a;
    border: 1dp #35405a;
    pointer-events: auto;
    box-sizing: border-box;
}

#viewport-panel {
    height: 70%;
    background-color: transparent;
    pointer-events: none;
}

#viewport-panel .panel-header {
    pointer-events: auto;
}

#timeline-panel {
    height: 30%;
}

#scene-tree-panel {
    height: 30%;
}

#properties-panel {
    height: 70%;
}

.viewport-spacer {
    height: 70%;
    pointer-events: none;
}

.scene-tree-spacer {
    height: 30%;
    pointer-events: none;
}

.panel-header {
    box-sizing: border-box;
    height: 28dp;
    padding: 5dp 9dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: #20283a;
    border-bottom: 1dp #35405a;
    color: #f0f3fb;
    font-size: 12dp;
}

.panel-header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    height: 100%;
}

.spawn-menu-btn,
.spawn-menu-button,
#spawn-menu-btn,
#spawn-menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
}

.spawn-menu-icon {
    width: 16dp;
    height: 16dp;
    display: inline-block;
}

.panel-meta {
    color: #8792aa;
    font-size: 10dp;
}

.panel-action {
    padding: 0 5dp;
    color: #9db8ff;
    font-size: 16dp;
}

#viewport-surface {
    position: absolute;
    top: 28dp;
    right: 0;
    bottom: 0;
    left: 0;
}

.scene-tree {
    padding: 6dp;
}

.scene-tree-search-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 6dp;
    padding: 3dp 6dp;
    background-color: #121826;
    border: 1dp #35405a;
    border-radius: 3dp;
}

.scene-tree-search-box:focus-within {
    border: 1dp #4a5a80;
}

.scene-tree-search-icon {
    display: inline-block;
    margin-right: 6dp;
    color: #8792aa;
    font-size: 11dp;
    font-family: "Noto Emoji";
}

.scene-tree-search {
    display: block;
    flex-grow: 1;
    box-sizing: border-box;
    padding: 2dp 0;
    background-color: transparent;
    border: 0;
    color: #dce3f2;
    font-size: 11dp;
}

.scene-tree-search::placeholder {
    color: #6f7a92;
}

.scene-tree-items {
    display: block;
}

.tree-children {
    display: block;
}

.tree-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 5dp 7dp;
    color: #c7cede;
    font-size: 12dp;
    cursor: pointer;
}

.tree-row:hover {
    background-color: #232d45;
    border-radius: 3dp;
}

.tree-root {
    color: #eef2fb;
}

.tree-row.selected {
    background-color: #31466f;
    color: #ffffff;
    border-radius: 3dp;
}

.tree-row.dragging {
    opacity: 0.4;
}

.tree-row.drag-over {
    background-color: #3a4a78;
    border: 1dp #7ea2ff;
    border-radius: 3dp;
}

.scene-tree-drag-indicator {
    position: absolute;
    z-index: 250;
    padding: 4dp 8dp;
    background-color: #1f2738;
    border: 1dp #7ea2ff;
    border-radius: 3dp;
    color: #eef2fb;
    font-size: 12dp;
    pointer-events: none;
    opacity: 0.95;
}

.tree-arrow {
    display: inline-block;
    width: 14dp;
    color: #8792aa;
    font-size: 10dp;
}

.tree-label {
    display: inline-block;
}

.tree-rename-input {
    flex-grow: 1;
    padding: 1dp 3dp;
    background-color: #121826;
    border: 1dp #4a5a80;
    color: #ffffff;
    font-size: 12dp;
}

.tree-empty {
    padding: 6dp 7dp;
    color: #7f8ba1;
    font-size: 11dp;
}

.scene-tree-context-menu {
    position: absolute;
    z-index: 200;
    min-width: 130dp;
    padding: 4dp 0;
    background-color: #232b3d;
    border: 1dp #384563;
    pointer-events: auto;
}

.context-menu-item {
    display: block;
    padding: 6dp 12dp;
    color: #dce3f2;
    font-size: 12dp;
    cursor: pointer;
}

.context-menu-item:hover {
    background-color: #3a4a78;
    color: #ffffff;
}

.properties-content {
    padding: 7dp;
}

.property-section {
    margin-top: 6dp;
    padding: 6dp 5dp;
    background-color: #1d2535;
    border-bottom: 1dp #3c4964;
    color: #dce3f2;
    font-size: 11dp;
}

.property-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 7dp 5dp;
    border-bottom: 1dp #242d3f;
    color: #9da8bc;
    font-size: 11dp;
}

.property-value {
    color: #d7deec;
}

.timeline-toolbar {
    height: 29dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 4dp;
    background-color: #151b27;
    border-bottom: 1dp #303a50;
}

.transport-button {
    min-width: 22dp;
    padding: 3dp 6dp;
    text-align: center;
    background-color: #293348;
    border: 1dp #3a4762;
    border-radius: 3dp;
    color: #cbd3e3;
    font-size: 10dp;
}

.transport-play {
    min-width: 38dp;
    color: #ffffff;
    background-color: #365891;
}

.timeline-content {
    position: absolute;
    top: 58dp;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: row;
}

.track-list {
    width: 150dp;
    background-color: #171e2b;
    border-right: 1dp #35405a;
}

.track-row {
    height: 25dp;
    padding: 5dp 9dp;
    border-bottom: 1dp #273044;
    color: #aeb8ca;
    font-size: 11dp;
}

.track-title {
    color: #eef2fb;
    background-color: #20283a;
}

.keyframe-area {
    position: relative;
    flex-grow: 1;
    background-color: #121722;
}

.time-ruler {
    height: 25dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 5dp 8dp;
    background-color: #1c2432;
    border-bottom: 1dp #303a50;
    color: #7f8ba1;
    font-size: 9dp;
}

.playhead {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 12%;
    width: 1dp;
    background-color: #ff6f61;
}

/* ── Spawn Menu ──────────────────────────────────────────────────────────── */

.spawn-menu-overlay {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 300;
    pointer-events: none;
}

.spawn-menu-overlay.open {
    display: block;
    pointer-events: auto;
}

.spawn-menu-window {
    position: absolute;
    top: 50%;
    left: 50%;
    margin-top: -220dp;
    margin-left: -460dp;
    width: 920dp;
    height: 440dp;
    background-color: #1a2130;
    border: 1dp #384563;
    box-sizing: border-box;
}

.spawn-menu-titlebar {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 26dp;
    padding: 0 8dp;
    background-color: #121826;
    border-bottom: 1dp #2f3a56;
    color: #f0f3fb;
    font-size: 13dp;
}

.spawn-menu-close {
    cursor: pointer;
    color: #9da8bc;
    padding: 0 4dp;
}

.spawn-menu-close:hover {
    color: #ffffff;
}

.spawn-menu-searchbar {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    padding: 6dp 8dp;
    border-bottom: 1dp #2f3a56;
    color: #c7cede;
    font-size: 12dp;
}

.spawn-menu-search {
    flex-grow: 1;
    box-sizing: border-box;
    padding: 3dp 6dp;
    background-color: #121826;
    border: 1dp #35405a;
    color: #dce3f2;
    font-size: 11dp;
}

.spawn-menu-clear-btn {
    padding: 3dp 8dp;
    background-color: #293348;
    border: 1dp #3a4762;
    color: #cbd3e3;
    font-size: 11dp;
    cursor: pointer;
}

.spawn-menu-clear-btn:hover {
    background-color: #3a4a78;
    color: #ffffff;
}

.spawn-menu-columns {
    position: absolute;
    top: 65dp;
    right: 0;
    bottom: 36dp;
    left: 0;
    display: flex;
    flex-direction: row;
}

.spawn-menu-col {
    width: 25%;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    border-right: 1dp #2f3a56;
    min-width: 0;
    min-height: 0;
}

.spawn-menu-col-title {
    padding: 5dp 8dp;
    color: #8792aa;
    font-size: 10dp;
    border-bottom: 1dp #2f3a56;
}

.spawn-menu-list {
    flex-grow: 1;
    overflow: auto;
    padding: 3dp;
}

.spawn-menu-item {
    display: block;
    padding: 5dp 7dp;
    margin-bottom: 1dp;
    color: #c7cede;
    font-size: 12dp;
    cursor: pointer;
}

.spawn-menu-item:hover {
    background-color: #232d45;
}

.spawn-menu-item.selected {
    background-color: #31466f;
    color: #ffffff;
}

.spawn-menu-item.disabled {
    color: #6f7a92;
    cursor: default;
}

.spawn-menu-empty {
    padding: 6dp 7dp;
    color: #6f7a92;
    font-size: 11dp;
}

.spawn-menu-preview-col {
    border-right: none;
    align-items: center;
}

.spawn-menu-preview {
    flex-grow: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #8792aa;
    font-size: 11dp;
    text-align: center;
}

.spawn-menu-preview-name {
    margin-top: 8dp;
    color: #dce3f2;
    font-size: 12dp;
}

.spawn-menu-bottombar {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 36dp;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding: 0 8dp;
    border-top: 1dp #2f3a56;
}

.spawn-menu-spawn-btn {
    padding: 5dp 16dp;
    background-color: #365891;
    border: 1dp #4a6ab0;
    color: #ffffff;
    font-size: 12dp;
    cursor: pointer;
}

.spawn-menu-spawn-btn:hover {
    background-color: #4169ad;
}

.spawn-menu-spawn-btn.disabled {
    background-color: #293348;
    border: 1dp #3a4762;
    color: #6f7a92;
    cursor: default;
}

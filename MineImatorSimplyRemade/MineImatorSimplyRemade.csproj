<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.3.1</Version>
        <AssemblyVersion>0.3.1.0</AssemblyVersion>
        <FileVersion>0.3.1.0</FileVersion>
        <InformationalVersion>v0.3.1</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <DefaultItemExcludes>$(DefaultItemExcludes);tools/**</DefaultItemExcludes>
        <!-- Third-party NativeAOT/single-file warnings from Silk.NET and FFMpegCore. -->
        <!-- NU1701: Package compatibility warnings for packages targeting older frameworks. -->
        <!-- Nullable reference type warnings (CS8600-CS8629): Architecture uses nullable patterns throughout. -->
        <!-- CS8619: Nullability mismatch in array initialization from shape vertex data. -->
        <!-- CS9192/CS9193: ref/ref readonly parameter passing in GlmSharp and struct operations. -->
        <NoWarn>$(NoWarn);IL2104;IL3000;IL3002;IL3053;NU1701;CS8600;CS8601;CS8603;CS8604;CS8618;CS8619;CS8625;CS8629;CS8981;CS9192;CS9193</NoWarn>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Cyotek.Data.Nbt" Version="4.0.0" />
      <PackageReference Include="FFMPEGCore-Fork" Version="1.0.0" />
      <PackageReference Include="FFMpegCore.Extensions.Downloader" Version="5.0.0" />
      <PackageReference Include="GlmSharp" Version="0.9.8" />
      <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
      <PackageReference Include="Hexa.NET.ImGui.Backends" Version="1.0.18" />
      <PackageReference Include="Hexa.NET.ImGui.Backends.GLFW" Version="1.0.18" />
      <PackageReference Include="Magick.NET-Q16-HDRI-AnyCPU" Version="15.0.0" />
      <PackageReference Include="NativeFileDialogSharp" Version="0.5.0" />
      <PackageReference Include="OpenAL.Soft" Version="1.23.1" />
      <PackageReference Include="Sentry" Version="6.7.0" />
      <PackageReference Include="Silk.NET.Assimp" Version="2.23.0" />
      <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
      <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
      <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
      <PackageReference Include="StbImageSharp" Version="2.30.15" />
      <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
      <PackageReference Include="Veldrid" Version="4.9.0" />
      <PackageReference Include="Veldrid.SPIRV" Version="1.0.15" />
      <PackageReference Include="Veldrid.StartupUtilities" Version="4.9.0" />
    </ItemGroup>
    
    <ItemGroup>
        <EmbeddedResource Include="assets\**" />
    </ItemGroup>

    <PropertyGroup>
        <IsPublishing Condition="'$(_IsPublishing)' == 'true' Or '$(DeployOnBuild)' == 'true' Or '$(PublishProtocol)' != '' Or '$(PublishProfile)' != '' Or '$(RuntimeIdentifier)' != '' Or '$(BuildingForPublish)' == 'true' Or $([System.String]::Copy('$(MSBuildTargets)').Contains('Publish')) Or $([System.String]::Copy('$(Target)').Contains('Publish'))">true</IsPublishing>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsPublishing)' == 'true'">
        <DanglingDllFiles Include="$(MSBuildProjectDirectory)\*.dll" />
        <EmbeddedResource Include="@(DanglingDllFiles)" LogicalName="%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsPublishing)' != 'true'">
        <None Include="$(MSBuildProjectDirectory)\*.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
    </ItemGroup>

    <Target Name="CopyDataFolder" AfterTargets="Build">
        <ItemGroup>
            <DataFiles Include="data\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(DataFiles)" DestinationFolder="$(OutputPath)data\%(RecursiveDir)" />
    </Target>
    <Target Name="CopyDataFolderPublish" AfterTargets="_CopyResolvedFilesToPublishAlways;_CopyResolvedFilesToPublishPreserveNewest;Publish;FileSystemPublish">
        <ItemGroup>
            <DataFiles Include="$(MSBuildProjectDirectory)\data\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(DataFiles)" DestinationFolder="$(PublishDir)data\%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyModsFolder" AfterTargets="Build">
        <ItemGroup>
            <ModFiles Include="mods\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(OutputPath)mods\%(RecursiveDir)" />
        <ItemGroup>
            <CopiedModGitkeepFiles Include="$(OutputPath)mods\**\*.gitkeep" />
        </ItemGroup>
        <Delete Files="@(CopiedModGitkeepFiles)" />
    </Target>

    <Target Name="CopyModsFolderPublish" AfterTargets="_CopyResolvedFilesToPublishAlways;_CopyResolvedFilesToPublishPreserveNewest;Publish;FileSystemPublish">
        <ItemGroup>
            <ModFiles Include="$(MSBuildProjectDirectory)\mods\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(PublishDir)mods\%(RecursiveDir)" SkipUnchangedFiles="true" />
        <ItemGroup>
            <PublishedModGitkeepFiles Include="$(PublishDir)mods\**\*.gitkeep" />
        </ItemGroup>
        <Delete Files="@(PublishedModGitkeepFiles)" />
    </Target>

    <Target Name="RemoveDanglingDllsFromPublish" AfterTargets="_CopyResolvedFilesToPublishAlways;_CopyResolvedFilesToPublishPreserveNewest;Publish;PublishOnly;_PublishNoBuild;FileSystemPublish">
        <ItemGroup>
            <PublishedDanglingDlls Include="$(PublishDir)*.dll" Exclude="$(PublishDir)$(TargetName).dll;$(PublishDir)Magick.Native-*.dll" Condition="'$(PublishAot)' != 'true'" />
            <PublishedDanglingDlls Include="$(PublishDir)*.dll" Exclude="$(PublishDir)Magick.Native-*.dll" Condition="'$(PublishAot)' == 'true'" />
        </ItemGroup>
        <Delete Files="@(PublishedDanglingDlls)" />
    </Target>

</Project>

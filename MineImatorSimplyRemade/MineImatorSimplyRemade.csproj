<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishSingleFile">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.5.0</Version>
        <AssemblyVersion>0.5.0.0</AssemblyVersion>
        <FileVersion>0.5.0.0</FileVersion>
        <InformationalVersion>v0.5.0</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <DefaultItemExcludes>$(DefaultItemExcludes);tools/**</DefaultItemExcludes>
        <!-- Third-party NativeAOT/single-file warnings from Silk.NET. -->
        <!-- NU1701: Package compatibility warnings for packages targeting older frameworks. -->
        <!-- Nullable reference type warnings (CS8600-CS8629): Architecture uses nullable patterns throughout. -->
        <!-- CS8619: Nullability mismatch in array initialization from shape vertex data. -->
        <!-- CS9192/CS9193: ref/ref readonly parameter passing in GlmSharp and struct operations. -->
        <NoWarn>$(NoWarn);IL2104;IL3000;IL3002;IL3053;NU1701;CS8600;CS8601;CS8603;CS8604;CS8618;CS8619;CS8625;CS8629;CS8981;CS9192;CS9193</NoWarn>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot>true</PublishAot>
        <PublishSingleFile Condition="'$(PublishAot)' == 'true'">false</PublishSingleFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Cyotek.Data.Nbt" Version="4.0.0" />
      <PackageReference Include="GlmSharp" Version="0.9.8" />
      <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
      <PackageReference Include="Hexa.NET.ImGui.Backends" Version="1.0.18" />
      <PackageReference Include="Hexa.NET.ImGui.Backends.GLFW" Version="1.0.18" />
      <PackageReference Include="JoltPhysicsSharp" Version="2.24.0" />
      <!-- Direct reference exposes $(PkgJoltPhysics_Native) so publish can embed joltc.dll. -->
      <PackageReference Include="JoltPhysics.Native" Version="1.2.0" GeneratePathProperty="true" />
      <!-- Direct reference exposes the package path so publish can embed Magick's native DLL. -->
      <PackageReference Include="Magick.NET-Q16-HDRI-AnyCPU" Version="15.0.0" GeneratePathProperty="true" />
      <PackageReference Include="NativeFileDialogSharp" Version="0.5.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <!-- Copy only the CPU runtime below; exclude package-native GPU backends from NativeAOT auto-embedding. -->
      <PackageReference Include="oneAPI.OIDN.NET" Version="2.5.1" GeneratePathProperty="true" ExcludeAssets="native" />
      <PackageReference Include="OpenAL.Soft" Version="1.23.1" />
      <PackageReference Include="Sentry" Version="6.7.0" />
      <PackageReference Include="Silk.NET.Assimp" Version="2.23.0" />
      <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
      <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
      <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
      <PackageReference Include="StbImageSharp" Version="2.30.15" />
      <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
      <PackageReference Include="Veldrid" Version="4.9.0" />
      <PackageReference Include="Veldrid.SPIRV" Version="1.0.15" />
      <PackageReference Include="Veldrid.StartupUtilities" Version="4.9.0" />
      <PackageReference Include="ZstdSharp.Port" Version="0.8.7" />
    </ItemGroup>
    
    <ItemGroup>
        <EmbeddedResource Include="assets\**" />
        <EmbeddedResource Update="assets\ffmpeg\win-x64.zip" LogicalName="MineImatorSimplyRemade.ffmpeg.win-x64.zip" />
    </ItemGroup>

    <Target Name="ValidateBundledFfmpeg" BeforeTargets="PrepareForBuild">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)\assets\ffmpeg\win-x64.zip')" Text="Bundled FFmpeg is missing. Restore assets/ffmpeg/win-x64.zip or run tools/UpdateBundledFfmpeg.ps1." />
    </Target>

    <PropertyGroup>
        <IsPublishing Condition="'$(_IsPublishing)' == 'true' Or '$(DeployOnBuild)' == 'true' Or '$(PublishProtocol)' != '' Or '$(PublishProfile)' != '' Or '$(RuntimeIdentifier)' != '' Or '$(BuildingForPublish)' == 'true' Or $([System.String]::Copy('$(MSBuildTargets)').Contains('Publish')) Or $([System.String]::Copy('$(Target)').Contains('Publish'))">true</IsPublishing>
    </PropertyGroup>

    <ItemGroup Condition="'$(OS)' == 'Windows_NT' and '$(IsPublishing)' != 'true' and Exists('$(PkgOneAPI_OIDN_NET)\runtimes\win-x64\native')">
        <None Include="$(PkgOneAPI_OIDN_NET)\runtimes\win-x64\native\OpenImageDenoise.dll" CopyToOutputDirectory="PreserveNewest" />
        <None Include="$(PkgOneAPI_OIDN_NET)\runtimes\win-x64\native\OpenImageDenoise_core.dll" CopyToOutputDirectory="PreserveNewest" />
        <None Include="$(PkgOneAPI_OIDN_NET)\runtimes\win-x64\native\OpenImageDenoise_device_cpu.dll" CopyToOutputDirectory="PreserveNewest" />
        <None Include="$(PkgOneAPI_OIDN_NET)\runtimes\win-x64\native\tbb12.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsPublishing)' == 'true'">
        <DanglingDllFiles Include="$(MSBuildProjectDirectory)\*.dll" />
        <DanglingDllFiles Include="$(PkgJoltPhysics_Native)\runtimes\win-x64\native\joltc.dll" />
        <DanglingDllFiles Include="$(PkgMagick_NET-Q16-HDRI-AnyCPU)\runtimes\win-x64\native\Magick.Native-Q16-HDRI-x64.dll" />
        <DanglingDllFiles Include="$(PkgOneAPI_OIDN_NET)\runtimes\win-x64\native\OpenImageDenoise.dll" Condition="'$(OS)' == 'Windows_NT' and Exists('$(PkgOneAPI_OIDN_NET)\runtimes\win-x64\native')" />
        <DanglingDllFiles Include="$(PkgOneAPI_OIDN_NET)\runtimes\win-x64\native\OpenImageDenoise_core.dll" Condition="'$(OS)' == 'Windows_NT' and Exists('$(PkgOneAPI_OIDN_NET)\runtimes\win-x64\native')" />
        <DanglingDllFiles Include="$(PkgOneAPI_OIDN_NET)\runtimes\win-x64\native\OpenImageDenoise_device_cpu.dll" Condition="'$(OS)' == 'Windows_NT' and Exists('$(PkgOneAPI_OIDN_NET)\runtimes\win-x64\native')" />
        <DanglingDllFiles Include="$(PkgOneAPI_OIDN_NET)\runtimes\win-x64\native\tbb12.dll" Condition="'$(OS)' == 'Windows_NT' and Exists('$(PkgOneAPI_OIDN_NET)\runtimes\win-x64\native')" />
        <EmbeddedResource Include="@(DanglingDllFiles)" LogicalName="%(Filename)%(Extension)" />
    </ItemGroup>

    <Target Name="EmbedPackageNativeDlls" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolvePackageAssets" Condition="'$(IsPublishing)' == 'true'">
        <PropertyGroup>
            <EmbeddedNativeDllNames>;@(DanglingDllFiles->'%(Filename)%(Extension)');</EmbeddedNativeDllNames>
        </PropertyGroup>
        <ItemGroup>
            <PackageNativeDllFiles Include="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.dll' and !$([System.String]::Copy('$(EmbeddedNativeDllNames)').Contains(';%(Filename)%(Extension);'))" />
            <EmbeddedResource Include="@(PackageNativeDllFiles)" LogicalName="%(Filename)%(Extension)" />
        </ItemGroup>
    </Target>

    <ItemGroup Condition="'$(IsPublishing)' != 'true'">
        <None Include="$(MSBuildProjectDirectory)\*.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="CopyDataFolder" AfterTargets="Build">
        <ItemGroup>
            <DataFiles Include="data\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(DataFiles)" DestinationFolder="$(OutputPath)data\%(RecursiveDir)" />
    </Target>
    <Target Name="CopyDataFolderPublish" AfterTargets="_CopyResolvedFilesToPublishAlways;_CopyResolvedFilesToPublishPreserveNewest;Publish;FileSystemPublish">
        <ItemGroup>
            <DataFiles Include="$(MSBuildProjectDirectory)\data\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(DataFiles)" DestinationFolder="$(PublishDir)data\%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyModsFolder" AfterTargets="Build">
        <ItemGroup>
            <ModFiles Include="mods\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(OutputPath)mods\%(RecursiveDir)" />
        <ItemGroup>
            <CopiedModGitkeepFiles Include="$(OutputPath)mods\**\*.gitkeep" />
        </ItemGroup>
        <Delete Files="@(CopiedModGitkeepFiles)" />
    </Target>

    <Target Name="CopyModsFolderPublish" AfterTargets="_CopyResolvedFilesToPublishAlways;_CopyResolvedFilesToPublishPreserveNewest;Publish;FileSystemPublish">
        <ItemGroup>
            <ModFiles Include="$(MSBuildProjectDirectory)\mods\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(PublishDir)mods\%(RecursiveDir)" SkipUnchangedFiles="true" />
        <ItemGroup>
            <PublishedModGitkeepFiles Include="$(PublishDir)mods\**\*.gitkeep" />
        </ItemGroup>
        <Delete Files="@(PublishedModGitkeepFiles)" />
    </Target>

    <Target Name="RemoveDanglingDllsFromPublish" AfterTargets="_CopyResolvedFilesToPublishAlways;_CopyResolvedFilesToPublishPreserveNewest;Publish;PublishOnly;_PublishNoBuild;FileSystemPublish">
        <ItemGroup>
            <PublishedDanglingDlls Include="@(DanglingDllFiles-&gt;'$(PublishDir)%(Filename)%(Extension)')" />
            <PublishedPackageNativeDlls Include="@(PackageNativeDllFiles-&gt;'$(PublishDir)%(Filename)%(Extension)')" />
        </ItemGroup>
        <Delete Files="@(PublishedDanglingDlls);@(PublishedPackageNativeDlls)" />
    </Target>

</Project>

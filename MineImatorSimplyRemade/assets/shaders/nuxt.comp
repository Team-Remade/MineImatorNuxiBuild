#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform image2D AccumulationImage;
layout(rgba8, binding = 1) writeonly uniform image2D OutputImage;

struct Triangle
{
    vec4 A;
    vec4 B;
    vec4 C;
    vec4 NormalA;
    vec4 NormalB;
    vec4 NormalC;
    vec4 UvAB;
    vec4 UvC;
    vec4 Albedo;
    vec4 Emission;
    vec4 Material;
    vec4 TextureTransform;
    vec4 TextureFrame;
    vec4 Flags;
    ivec4 AlbedoTexture;
    ivec4 EmissionTexture;
    ivec4 AlphaTexture;
    vec4 MultiplyHsv;
    vec4 AddRgb;
    vec4 AddHsv;
    vec4 SubtractRgb;
    vec4 SubtractHsv;
    int MaterialIndex;
};

struct PointLight
{
    vec4 Position;
    vec4 Direction;
    vec4 ColorEnergy;
    vec4 RangeSpot;
};

struct DirectionalLight
{
    vec4 Direction;
    vec4 Radiance;
    vec4 Flags;
};

layout(binding = 0) uniform sampler2D uNodeBounds;
layout(binding = 1) uniform isampler2D uNodeData;
layout(binding = 2) uniform isampler2D uTriangleIndices;
layout(binding = 3) uniform sampler2D uGeometry;
layout(binding = 4) uniform isampler2D uTriangleMaterials;
layout(binding = 5) uniform sampler2D uMaterials;
layout(binding = 6) uniform isampler2D uMaterialTextureRefs;
layout(binding = 7) uniform sampler2D uPointLights;
layout(binding = 8) uniform sampler2D uDirectionalLights;
layout(binding = 9) uniform sampler2D uTexturePixels;
layout(binding = 10) uniform sampler2D uTlasBounds;
layout(binding = 11) uniform isampler2D uTlasData;
layout(binding = 12) uniform isampler2D uTlasInstanceIndices;
layout(binding = 13) uniform sampler2D uInstanceTransforms;
layout(binding = 14) uniform isampler2D uInstanceInfo;

uniform int uWidth;
uniform int uHeight;

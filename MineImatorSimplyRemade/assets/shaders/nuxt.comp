const float Pi = 3.14159265358979323846;
const float RayEpsilon = 0.0005;
// Texels per material: 11 surface texels, then graph info, bounds min and frame, bounds size, path rows.
const int MaterialStride = 15;

uint RandomState;

ivec2 TexelCoordinate(int index, int width)
{
    return ivec2(index % width, index / width);
}

Triangle LoadTriangle(int index, int instanceIndex)
{
    Triangle triangle;
    int geometryOffset = index * 8;
    triangle.A = texelFetch(uGeometry, TexelCoordinate(geometryOffset, uGeometryWidth), 0);
    triangle.B = texelFetch(uGeometry, TexelCoordinate(geometryOffset + 1, uGeometryWidth), 0);
    triangle.C = texelFetch(uGeometry, TexelCoordinate(geometryOffset + 2, uGeometryWidth), 0);
    triangle.NormalA = texelFetch(uGeometry, TexelCoordinate(geometryOffset + 3, uGeometryWidth), 0);
    triangle.NormalB = texelFetch(uGeometry, TexelCoordinate(geometryOffset + 4, uGeometryWidth), 0);
    triangle.NormalC = texelFetch(uGeometry, TexelCoordinate(geometryOffset + 5, uGeometryWidth), 0);
    triangle.UvAB = texelFetch(uGeometry, TexelCoordinate(geometryOffset + 6, uGeometryWidth), 0);
    triangle.UvC = texelFetch(uGeometry, TexelCoordinate(geometryOffset + 7, uGeometryWidth), 0);

    int materialIndex = texelFetch(uTriangleMaterials,
        TexelCoordinate(index, uTriangleMaterialsWidth), 0).r;
    int instanceMaterial = texelFetch(uInstanceInfo,
        TexelCoordinate(instanceIndex, uInstanceInfoWidth), 0).y;
    if (instanceMaterial >= 0)
        materialIndex = instanceMaterial;
    triangle.MaterialIndex = materialIndex;
    int materialOffset = materialIndex * MaterialStride;
    triangle.Albedo = texelFetch(uMaterials, TexelCoordinate(materialOffset, uMaterialsWidth), 0);
    triangle.Emission = texelFetch(uMaterials, TexelCoordinate(materialOffset + 1, uMaterialsWidth), 0);
    triangle.Material = texelFetch(uMaterials, TexelCoordinate(materialOffset + 2, uMaterialsWidth), 0);
    triangle.TextureTransform = texelFetch(uMaterials, TexelCoordinate(materialOffset + 3, uMaterialsWidth), 0);
    triangle.TextureFrame = texelFetch(uMaterials, TexelCoordinate(materialOffset + 4, uMaterialsWidth), 0);
    triangle.Flags = texelFetch(uMaterials, TexelCoordinate(materialOffset + 5, uMaterialsWidth), 0);
    triangle.MultiplyHsv = texelFetch(uMaterials, TexelCoordinate(materialOffset + 6, uMaterialsWidth), 0);
    triangle.AddRgb = texelFetch(uMaterials, TexelCoordinate(materialOffset + 7, uMaterialsWidth), 0);
    triangle.AddHsv = texelFetch(uMaterials, TexelCoordinate(materialOffset + 8, uMaterialsWidth), 0);
    triangle.SubtractRgb = texelFetch(uMaterials, TexelCoordinate(materialOffset + 9, uMaterialsWidth), 0);
    triangle.SubtractHsv = texelFetch(uMaterials, TexelCoordinate(materialOffset + 10, uMaterialsWidth), 0);
    triangle.AlbedoTexture = texelFetch(uMaterialTextureRefs,
        TexelCoordinate(materialIndex * 3, uMaterialTextureRefsWidth), 0);
    triangle.EmissionTexture = texelFetch(uMaterialTextureRefs,
        TexelCoordinate(materialIndex * 3 + 1, uMaterialTextureRefsWidth), 0);
    triangle.AlphaTexture = texelFetch(uMaterialTextureRefs,
        TexelCoordinate(materialIndex * 3 + 2, uMaterialTextureRefsWidth), 0);
    return triangle;
}

float RandomFloat()
{
    RandomState ^= RandomState << 13;
    RandomState ^= RandomState >> 17;
    RandomState ^= RandomState << 5;
    return float(RandomState >> 8) * (1.0 / 16777216.0);
}

vec3 SafeNormalize(vec3 value, vec3 fallbackValue)
{
    float lengthSquared = dot(value, value);
    return lengthSquared > 1e-20 ? value * inversesqrt(lengthSquared) : fallbackValue;
}

bool IntersectBounds(vec3 minimum, vec3 maximum, vec3 origin, vec3 direction, float maximumDistance)
{
    float nearDistance = RayEpsilon;
    float farDistance = maximumDistance;
    for (int axis = 0; axis < 3; axis++)
    {
        float rayOrigin = origin[axis];
        float rayDirection = direction[axis];
        if (abs(rayDirection) < 1e-20)
        {
            if (rayOrigin < minimum[axis] || rayOrigin > maximum[axis])
                return false;
            continue;
        }
        float inverseDirection = 1.0 / rayDirection;
        float first = (minimum[axis] - rayOrigin) * inverseDirection;
        float second = (maximum[axis] - rayOrigin) * inverseDirection;
        if (first > second)
        {
            float swapValue = first;
            first = second;
            second = swapValue;
        }
        nearDistance = max(nearDistance, first);
        farDistance = min(farDistance, second);
        if (farDistance < nearDistance)
            return false;
    }
    return true;
}

bool IntersectTriangle(Triangle triangle, vec3 origin, vec3 direction, float maximumDistance,
    out float distance, out vec3 barycentric)
{
    vec3 edge1 = triangle.B.xyz - triangle.A.xyz;
    vec3 edge2 = triangle.C.xyz - triangle.A.xyz;
    vec3 p = cross(direction, edge2);
    float determinant = dot(edge1, p);
    if (abs(determinant) < 1e-8)
        return false;
    float inverse = 1.0 / determinant;
    vec3 fromA = origin - triangle.A.xyz;
    float u = dot(fromA, p) * inverse;
    if (u < 0.0 || u > 1.0)
        return false;
    vec3 q = cross(fromA, edge1);
    float v = dot(direction, q) * inverse;
    if (v < 0.0 || u + v > 1.0)
        return false;
    distance = dot(edge2, q) * inverse;
    barycentric = vec3(1.0 - u - v, u, v);
    return distance >= RayEpsilon && distance <= maximumDistance;
}

vec4 InstanceTransformValue(int instanceIndex, int field, bool inverseTransform)
{
    int transformIndex = instanceIndex * 6 + (inverseTransform ? 3 : 0) + field;
    return texelFetch(uInstanceTransforms,
        TexelCoordinate(transformIndex, uInstanceTransformsWidth), 0);
}

ivec4 InstanceInfo(int instanceIndex)
{
    return texelFetch(uInstanceInfo, TexelCoordinate(instanceIndex, uInstanceInfoWidth), 0);
}

vec3 TransformInstancePoint(int instanceIndex, vec3 point, bool inverseTransform)
{
    vec4 value = vec4(point, 1.0);
    return vec3(dot(value, InstanceTransformValue(instanceIndex, 0, inverseTransform)),
        dot(value, InstanceTransformValue(instanceIndex, 1, inverseTransform)),
        dot(value, InstanceTransformValue(instanceIndex, 2, inverseTransform)));
}

vec3 TransformInstanceDirection(int instanceIndex, vec3 direction, bool inverseTransform)
{
    vec4 value = vec4(direction, 0.0);
    return vec3(dot(value, InstanceTransformValue(instanceIndex, 0, inverseTransform)),
        dot(value, InstanceTransformValue(instanceIndex, 1, inverseTransform)),
        dot(value, InstanceTransformValue(instanceIndex, 2, inverseTransform)));
}

vec3 TransformInstanceNormal(int instanceIndex, vec3 normal)
{
    vec4 inverseX = InstanceTransformValue(instanceIndex, 0, true);
    vec4 inverseY = InstanceTransformValue(instanceIndex, 1, true);
    vec4 inverseZ = InstanceTransformValue(instanceIndex, 2, true);
    return SafeNormalize(vec3(dot(normal, vec3(inverseX.x, inverseY.x, inverseZ.x)),
        dot(normal, vec3(inverseX.y, inverseY.y, inverseZ.y)),
        dot(normal, vec3(inverseX.z, inverseY.z, inverseZ.z))), vec3(0.0, 1.0, 0.0));
}

bool IntersectBlas(int rootNode, int instanceIndex, vec3 origin, vec3 direction, float maximumDistance,
    out int hitIndex, out float hitDistance, out vec3 barycentric)
{
    hitIndex = -1;
    hitDistance = maximumDistance;
    if (rootNode < 0 || uNodeCount == 0)
        return false;

    int stack[128];
    int stackCount = 1;
    stack[0] = rootNode;
    while (stackCount > 0)
    {
        int nodeIndex = stack[--stackCount];
        vec3 minimum = texelFetch(uNodeBounds,
            TexelCoordinate(nodeIndex * 2, uNodeBoundsWidth), 0).xyz;
        vec3 maximum = texelFetch(uNodeBounds,
            TexelCoordinate(nodeIndex * 2 + 1, uNodeBoundsWidth), 0).xyz;
        if (!IntersectBounds(minimum, maximum, origin, direction, hitDistance))
            continue;
        ivec4 nodeData = texelFetch(uNodeData, TexelCoordinate(nodeIndex, uNodeDataWidth), 0);
        int count = nodeData.y;
        if (count > 0)
        {
            int start = nodeData.x;
            for (int i = start; i < start + count; i++)
            {
                int triangleIndex = texelFetch(uTriangleIndices,
                    TexelCoordinate(i, uTriangleIndicesWidth), 0).r;
                float distance;
                vec3 candidateBarycentric;
                if (IntersectTriangle(LoadTriangle(triangleIndex, instanceIndex), origin, direction, hitDistance,
                    distance, candidateBarycentric))
                {
                    hitIndex = triangleIndex;
                    hitDistance = distance;
                    barycentric = candidateBarycentric;
                }
            }
        }
        else if (stackCount + 2 <= 128)
        {
            stack[stackCount++] = nodeData.z;
            stack[stackCount++] = nodeData.w;
        }
    }
    return hitIndex >= 0;
}

bool IntersectScene(vec3 origin, vec3 direction, float maximumDistance, out int hitIndex,
    out int hitInstance, out float hitDistance, out vec3 barycentric)
{
    hitIndex = -1;
    hitInstance = -1;
    hitDistance = maximumDistance;
    if (uTlasNodeCount == 0 || uInstanceCount == 0)
        return false;

    int stack[128];
    int stackCount = 1;
    stack[0] = 0;
    while (stackCount > 0)
    {
        int nodeIndex = stack[--stackCount];
        vec3 minimum = texelFetch(uTlasBounds,
            TexelCoordinate(nodeIndex * 2, uTlasBoundsWidth), 0).xyz;
        vec3 maximum = texelFetch(uTlasBounds,
            TexelCoordinate(nodeIndex * 2 + 1, uTlasBoundsWidth), 0).xyz;
        if (!IntersectBounds(minimum, maximum, origin, direction, hitDistance))
            continue;
        ivec4 nodeData = texelFetch(uTlasData, TexelCoordinate(nodeIndex, uTlasDataWidth), 0);
        if (nodeData.y > 0)
        {
            for (int i = nodeData.x; i < nodeData.x + nodeData.y; i++)
            {
                int instanceIndex = texelFetch(uTlasInstanceIndices,
                    TexelCoordinate(i, uTlasInstanceIndicesWidth), 0).r;
                ivec4 instanceInfo = InstanceInfo(instanceIndex);
                vec3 localOrigin = TransformInstancePoint(instanceIndex, origin, true);
                vec3 localDirection = TransformInstanceDirection(instanceIndex, direction, true);
                int candidateIndex;
                float candidateDistance;
                vec3 candidateBarycentric;
                if (IntersectBlas(instanceInfo.x, instanceIndex, localOrigin, localDirection, hitDistance,
                        candidateIndex, candidateDistance, candidateBarycentric))
                {
                    hitIndex = candidateIndex;
                    hitInstance = instanceIndex;
                    hitDistance = candidateDistance;
                    barycentric = candidateBarycentric;
                }
            }
        }
        else if (stackCount + 2 <= 128)
        {
            stack[stackCount++] = nodeData.z;
            stack[stackCount++] = nodeData.w;
        }
    }
    return hitIndex >= 0;
}

vec4 SampleTexture(vec2 uv, ivec4 reference)
{
    if (reference.x < 0)
        return vec4(1.0);
    int width = reference.y;
    int height = reference.z;
    if (width <= 0 || height <= 0)
        return vec4(1.0);
    vec2 wrapped = fract(uv);
    ivec2 pixel = ivec2(clamp(wrapped * vec2(width, height), vec2(0.0), vec2(width - 1, height - 1)));
    int texturePixel = reference.x + pixel.y * width + pixel.x;
    return texelFetch(uTexturePixels, TexelCoordinate(texturePixel, uTexturePixelsWidth), 0);
}

float SrgbToLinear(float value)
{
    return value <= 0.04045 ? value / 12.92 : pow((value + 0.055) / 1.055, 2.4);
}

#define GRAPH_COMPUTE
#include "shader_graph.glsl"

vec3 RgbToHsv(vec3 color)
{
    vec4 k = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(color.bg, k.wz), vec4(color.gb, k.xy), step(color.b, color.g));
    vec4 q = mix(vec4(p.xyw, color.r), vec4(color.r, p.yzx), step(p.x, color.r));
    float chroma = q.x - min(q.w, q.y);
    float epsilon = 1e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * chroma + epsilon)),
        chroma / (q.x + epsilon), q.x);
}

vec3 HsvToRgb(vec3 hsv)
{
    vec3 p = abs(fract(hsv.xxx + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return hsv.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), clamp(hsv.y, 0.0, 1.0));
}

vec2 TransformUv(Triangle triangle, vec2 uv)
{
    uv.y = uv.y * triangle.TextureFrame.x + triangle.TextureFrame.y;
    vec2 transformed = uv * triangle.TextureTransform.zw + triangle.TextureTransform.xy;
    if (triangle.TextureFrame.z > 0.5 && mod(floor(transformed.x), 2.0) != 0.0)
        transformed.x = ceil(transformed.x) - transformed.x;
    if (triangle.TextureFrame.w > 0.5 && mod(floor(transformed.y), 2.0) != 0.0)
        transformed.y = ceil(transformed.y) - transformed.y;
    return transformed;
}

vec4 SampleAlbedo(Triangle triangle, vec2 uv)
{
    vec2 transformedUv = TransformUv(triangle, uv);
    vec4 texel = SampleTexture(transformedUv, triangle.AlbedoTexture);
    vec3 color = triangle.Albedo.rgb * vec3(SrgbToLinear(texel.r), SrgbToLinear(texel.g), SrgbToLinear(texel.b));
    if (triangle.Flags.w > 0.5)
    {
        if (any(notEqual(triangle.MultiplyHsv.xyz, vec3(1.0))))
            color = HsvToRgb(RgbToHsv(max(color, vec3(0.0))) * triangle.MultiplyHsv.xyz);
        if (any(notEqual(triangle.AddRgb.xyz, vec3(0.0))))
            color = clamp(color + triangle.AddRgb.xyz, 0.0, 1.0);
        if (any(notEqual(triangle.AddHsv.xyz, vec3(0.0))))
            color = HsvToRgb(RgbToHsv(max(color, vec3(0.0))) + triangle.AddHsv.xyz);
        if (any(notEqual(triangle.SubtractRgb.xyz, vec3(0.0))))
            color = clamp(color - triangle.SubtractRgb.xyz, 0.0, 1.0);
        if (any(notEqual(triangle.SubtractHsv.xyz, vec3(0.0))))
            color = HsvToRgb(RgbToHsv(max(color, vec3(0.0))) - triangle.SubtractHsv.xyz);
    }
    float alpha = triangle.Albedo.a * texel.a * SampleTexture(transformedUv, triangle.AlphaTexture).a;
    return vec4(color, clamp(alpha, 0.0, 1.0));
}

vec3 SampleEmission(Triangle triangle, vec2 uv)
{
    vec4 texel = SampleTexture(TransformUv(triangle, uv), triangle.EmissionTexture);
    return triangle.Emission.rgb * vec3(SrgbToLinear(texel.r), SrgbToLinear(texel.g), SrgbToLinear(texel.b));
}

// ── Custom shader graphs ─────────────────────────────────────────────────────

struct GraphMaterial
{
    int row;
    bool volume;
    bool translucent;
    float time;
    float frame;
    vec3 boundsMin;
    vec3 boundsSize;
    ivec4 paths;
};

// row is -1 for materials without a usable graph.
GraphMaterial LoadGraphMaterial(int materialIndex)
{
    GraphMaterial graph;
    int offset = materialIndex * MaterialStride;
    vec4 info = texelFetch(uMaterials, TexelCoordinate(offset + 11, uMaterialsWidth), 0);
    graph.row = int(info.x + 0.5) - 1;
    graph.volume = info.y > 0.5;
    graph.translucent = info.z > 0.5;
    graph.time = info.w;
    graph.frame = 0.0;
    graph.boundsMin = vec3(0.0);
    graph.boundsSize = vec3(1.0);
    graph.paths = ivec4(-1);
    if (graph.row >= 0)
    {
        vec4 minimum = texelFetch(uMaterials, TexelCoordinate(offset + 12, uMaterialsWidth), 0);
        vec4 size = texelFetch(uMaterials, TexelCoordinate(offset + 13, uMaterialsWidth), 0);
        vec4 paths = texelFetch(uMaterials, TexelCoordinate(offset + 14, uMaterialsWidth), 0);
        graph.frame = minimum.w;
        graph.boundsMin = minimum.xyz;
        graph.boundsSize = size.xyz;
        graph.paths = ivec4(paths + 0.5) - 1;
    }
    return graph;
}

mat4 InstanceMatrix(int instanceIndex)
{
    vec4 x = InstanceTransformValue(instanceIndex, 0, false);
    vec4 y = InstanceTransformValue(instanceIndex, 1, false);
    vec4 z = InstanceTransformValue(instanceIndex, 2, false);
    return mat4(x.x, y.x, z.x, 0.0, x.y, y.y, z.y, 0.0, x.z, y.z, z.z, 0.0, x.w, y.w, z.w, 1.0);
}

// Selects the graph row and the per-material inputs the interpreter reads.
void BindGraph(GraphMaterial graph, int materialIndex, int instanceIndex)
{
    vec4 header = texelFetch(uShaderGraphData, ivec2(0, graph.row), 0);
    gGraphRow = graph.row;
    gGraphCount = int(header.x);
    gGraphOutputStart = int(header.y);
    gGraphFlags = int(header.z);
    gGraphFrame = graph.frame;
    gGraphPaths = graph.paths;
    uShaderGraphBoundsMin = graph.boundsMin;
    uShaderGraphBoundsSize = graph.boundsSize;
    gGraphTexture = texelFetch(uMaterialTextureRefs, TexelCoordinate(materialIndex * 3, uMaterialTextureRefsWidth), 0);
    vec4 albedo = texelFetch(uMaterials, TexelCoordinate(materialIndex * MaterialStride, uMaterialsWidth), 0);
    uAlbedo = albedo.rgb;
    uAlpha = albedo.a;
    uModel = InstanceMatrix(instanceIndex);
}

// Graph colors are display values, like the viewport's; the tracer works in linear light.
vec3 SrgbToLinear3(vec3 color)
{
    return vec3(SrgbToLinear(color.r), SrgbToLinear(color.g), SrgbToLinear(color.b));
}

vec3 GraphEmissionToLinear(vec3 emission)
{
    return SrgbToLinear3(min(emission, vec3(1.0))) + max(emission - vec3(1.0), vec3(0.0));
}

vec3 InterpolatedNormal(Triangle triangle, vec3 barycentric)
{
    vec3 localNormal = triangle.NormalA.xyz * barycentric.x + triangle.NormalB.xyz * barycentric.y +
        triangle.NormalC.xyz * barycentric.z;
    return SafeNormalize(localNormal, SafeNormalize(cross(triangle.B.xyz - triangle.A.xyz,
        triangle.C.xyz - triangle.A.xyz), vec3(0.0, 1.0, 0.0)));
}

// Runs a surface graph at a hit. A graph with a linked Bump Height also returns a perturbed shading normal,
// from the height at two points a small step along the surface.
NodeSurface EvaluateGraphHit(GraphMaterial graph, int materialIndex, int instanceIndex, vec2 uv, vec3 localPosition,
    vec3 facingNormal, vec3 incoming, bool backfacing, bool allowBump, out vec3 shadingNormal)
{
    shadingNormal = facingNormal;
    BindGraph(graph, materialIndex, instanceIndex);
    vec3 worldPosition = TransformInstancePoint(instanceIndex, localPosition, false);
    bool bump = allowBump && (gGraphFlags & GRAPH_BUMP_LINKED) != 0;
    vec3 tangent = SafeNormalize(abs(facingNormal.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), facingNormal) :
        cross(vec3(1.0, 0.0, 0.0), facingNormal), vec3(1.0, 0.0, 0.0));
    vec3 bitangent = cross(facingNormal, tangent);
    const float bumpStep = 0.01;
    NodeSurface result = NodeSurface(vec3(0.0), 1.0, 0.0, vec3(0.0), 0.0, 1.0, 1.45, 0.0, 0.5, 1.0, 0.0);
    float heights[3] = float[3](0.0, 0.0, 0.0);
    for (int k = 0; k < (bump ? 3 : 1); k++)
    {
        vec3 offsetWorld = k == 1 ? tangent * bumpStep : k == 2 ? bitangent * bumpStep : vec3(0.0);
        vec3 local = localPosition + (k == 0 ? vec3(0.0) : TransformInstanceDirection(instanceIndex, offsetWorld, true));
        runShaderGraph(local, uv, worldPosition + offsetWorld, facingNormal, incoming, backfacing, graph.time);
        NodeSurface evaluated = readShaderGraphSurface();
        if (k == 0)
            result = evaluated;
        heights[k] = evaluated.height * evaluated.bumpStrength;
    }
    if (bump)
    {
        vec3 gradient = ((heights[1] - heights[0]) * tangent + (heights[2] - heights[0]) * bitangent) / bumpStep;
        shadingNormal = SafeNormalize(facingNormal - 0.025 * gradient, facingNormal);
    }
    return result;
}

// Whether a surface hit stops a shadow ray. Fog volumes never block light; their medium is integrated instead.
bool SurfaceBlocksLight(Triangle triangle, int instanceIndex, vec3 barycentric)
{
    GraphMaterial graph = LoadGraphMaterial(triangle.MaterialIndex);
    if (graph.volume)
        return false;
    vec2 uv = triangle.UvAB.xy * barycentric.x + triangle.UvAB.zw * barycentric.y + triangle.UvC.xy * barycentric.z;
    vec4 surface = SampleAlbedo(triangle, uv);
    if (graph.row >= 0 && graph.translucent)
    {
        vec3 localPosition = triangle.A.xyz * barycentric.x + triangle.B.xyz * barycentric.y + triangle.C.xyz * barycentric.z;
        vec3 worldNormal = TransformInstanceNormal(instanceIndex, InterpolatedNormal(triangle, barycentric));
        vec3 shadingNormal;
        NodeSurface evaluated = EvaluateGraphHit(graph, triangle.MaterialIndex, instanceIndex, TransformUv(triangle, uv),
            localPosition, worldNormal, worldNormal, false, false, shadingNormal);
        // Glass lets most light through.
        surface.a *= evaluated.alpha * (1.0 - evaluated.transmission * (1.0 - evaluated.metallic));
    }
    bool clipped = triangle.Flags.x > 0.5 && surface.a < triangle.Material.z;
    bool transparent = triangle.Flags.x > 0.5 ? clipped : surface.a <= 0.0 ||
        surface.a < 1.0 && RandomFloat() > surface.a;
    return !transparent;
}

bool IsOccluded(vec3 origin, vec3 direction, float maximumDistance)
{
    for (int layer = 0; layer < 32; layer++)
    {
        int triangleIndex;
        int instanceIndex;
        float distance;
        vec3 barycentric;
        if (!IntersectScene(origin, direction, maximumDistance, triangleIndex, instanceIndex, distance, barycentric))
            return false;
        Triangle triangle = LoadTriangle(triangleIndex, instanceIndex);
        if (SurfaceBlocksLight(triangle, instanceIndex, barycentric))
            return true;
        origin += direction * (distance + RayEpsilon);
        maximumDistance -= distance + RayEpsilon;
        if (maximumDistance <= RayEpsilon)
            return false;
    }
    return true;
}

// ── Fog volumes ──────────────────────────────────────────────────────────────
//
// A fog volume is a closed mesh whose material graph ends in a Fog Volume Output. A ray enters it through a
// front-facing surface hit and leaves through the next hit on the same instance; a back-facing first hit means
// the ray started inside. Between those hits the medium is ray marched: scattering uses ambient light plus one
// randomly chosen light per lit step, absorption and scattering attenuate, and emission adds light.

struct VolumeSample
{
    float sigmaScatter;
    vec3 sigmaTotal;
    vec3 albedo;
    vec3 emission;
    float anisotropy;
    float softness;
};

float HenyeyGreenstein(float cosine, float g)
{
    float denominator = 1.0 + g * g - 2.0 * g * cosine;
    return (1.0 - g * g) / (4.0 * Pi * pow(max(denominator, 1e-4), 1.5));
}

// Centre of the voxel containing p. Randomness merges whole blocks of 2x2x2 or 4x4x4 voxels, so voxel sizes vary.
vec3 SnapToVoxel(vec3 p, float size, float randomness)
{
    vec3 cell = floor(p / size);
    if (randomness > 0.0)
    {
        vec3 large = floor(cell * 0.25);
        if (graphHash(large + 17.0).x < randomness * 0.25)
            return (large * 4.0 + 2.0) * size;
        vec3 medium = floor(cell * 0.5);
        if (graphHash(medium + 41.0).x < randomness * 0.5)
            return (medium * 2.0 + 1.0) * size;
    }
    return (cell + 0.5) * size;
}

// settings = (voxel size, voxel size randomness, top cutoff, ignore object scale); height is the unsnapped
// object-space height. The result is an object-space point. When the object's scale is ignored the voxel grid is
// laid out in world-sized units (the scale of uModel, bound by BindGraph) and converted back.
vec3 VolumeVoxelCenter(int instanceIndex, vec4 settings, vec3 worldPoint, out float height)
{
    vec3 rawLocal = TransformInstancePoint(instanceIndex, worldPoint, true);
    height = rawLocal.y;
    if (settings.x <= 1e-4)
        return rawLocal;
    if (settings.w > 0.5)
    {
        vec3 scale = graphMatrixScale(uModel);
        return SnapToVoxel(rawLocal * scale, settings.x, settings.y) / scale;
    }
    return SnapToVoxel(rawLocal, settings.x, settings.y);
}

// Runs the graph at an object-space point. The coefficients exclude the per-step edge and cutoff factors.
VolumeSample EvaluateVolumeAt(GraphMaterial graph, int materialIndex, int instanceIndex, vec3 local, vec3 direction)
{
    BindGraph(graph, materialIndex, instanceIndex);
    vec3 worldPoint = TransformInstancePoint(instanceIndex, local, false);
    // Ignoring the object's scale feeds the graph a position measured in world blocks along the object's axes, and
    // Generated coordinates that grow outward from the bounds' centre.
    gGraphPositionScale = readShaderGraphVolumeSettings().w > 0.5 ? graphMatrixScale(uModel) : vec3(1.0);
    vec3 generated = graphGeneratedCoordinates(local, gGraphPositionScale);
    runShaderGraph(local * gGraphPositionScale, generated.xz, worldPoint, vec3(0.0, 1.0, 0.0), -direction, false, graph.time);
    gGraphPositionScale = vec3(1.0);
    NodeVolume volume = readShaderGraphVolume();
    float sigma = volume.density * volume.pathVisibility * GRAPH_VOLUME_DENSITY;
    VolumeSample result;
    result.sigmaScatter = sigma * volume.scattering;
    result.sigmaTotal = vec3(result.sigmaScatter) +
        sigma * volume.absorption * (vec3(1.0) - SrgbToLinear3(volume.extinctionColor));
    result.albedo = SrgbToLinear3(volume.color);
    result.emission = GraphEmissionToLinear(volume.emission) *
        (volume.emissionStrength * volume.density * volume.pathVisibility);
    result.anisotropy = volume.anisotropy;
    result.softness = volume.softness;
    return result;
}

// Fades density towards the surfaces the ray entered and left through, and below the top cutoff plane.
float VolumeStepFactor(GraphMaterial graph, vec4 settings, float softness, float height, float t,
    float segmentLength, bool entryBoundary, bool exitBoundary)
{
    float edgeDistance = min(entryBoundary ? t : 1e30, exitBoundary ? segmentLength - t : 1e30);
    float width = min(softness, 0.5 * segmentLength);
    float edge = width > 1e-4 ? smoothstep(0.0, width, edgeDistance) : 1.0;
    float cutoff = 1.0;
    if (settings.z < 1.0)
    {
        float plane = graph.boundsMin.y + settings.z * graph.boundsSize.y;
        cutoff = softness > 1e-4 ? 1.0 - smoothstep(plane - softness, plane, height) : (height <= plane ? 1.0 : 0.0);
    }
    return edge * cutoff;
}

// Transmittance through one medium segment of a shadow ray, from a few samples.
vec3 VolumeTransmittance(vec3 origin, vec3 direction, float segmentLength, int instanceIndex, int materialIndex,
    bool entryBoundary, bool exitBoundary)
{
    GraphMaterial graph = LoadGraphMaterial(materialIndex);
    if (graph.row < 0 || segmentLength <= 1e-5)
        return vec3(1.0);
    BindGraph(graph, materialIndex, instanceIndex);
    vec4 settings = readShaderGraphVolumeSettings();
    const int shadowSteps = 6;
    float stepLength = segmentLength / float(shadowSteps);
    vec3 opticalDepth = vec3(0.0);
    for (int i = 0; i < shadowSteps; i++)
    {
        float t = (float(i) + 0.5) * stepLength;
        float height;
        vec3 center = VolumeVoxelCenter(instanceIndex, settings, origin + direction * t, height);
        VolumeSample volume = EvaluateVolumeAt(graph, materialIndex, instanceIndex, center, direction);
        float factor = VolumeStepFactor(graph, settings, volume.softness, height, t, segmentLength,
            entryBoundary, exitBoundary);
        opticalDepth += volume.sigmaTotal * factor * stepLength;
    }
    return exp(-opticalDepth);
}

// Light remaining along a shadow ray: zero when an opaque surface blocks it, reduced by fog it crosses.
vec3 ShadowTransmittance(vec3 origin, vec3 direction, float maximumDistance)
{
    if (uHasVolumes == 0)
        return IsOccluded(origin, direction, maximumDistance) ? vec3(0.0) : vec3(1.0);

    vec3 transmittance = vec3(1.0);
    int insideInstance = -1;
    int insideMaterial = -1;
    bool entryBoundary = false;
    float remaining = maximumDistance;
    for (int layer = 0; layer < 48; layer++)
    {
        int triangleIndex;
        int instanceIndex;
        float hitDistance;
        vec3 barycentric;
        if (!IntersectScene(origin, direction, remaining, triangleIndex, instanceIndex, hitDistance, barycentric))
        {
            // A light inside the medium: the segment ends at the light, not at a surface.
            if (insideInstance >= 0 && uVolumeShadows != 0 && remaining < 1e30)
                transmittance *= VolumeTransmittance(origin, direction, remaining, insideInstance, insideMaterial,
                    entryBoundary, false);
            return transmittance;
        }
        Triangle triangle = LoadTriangle(triangleIndex, instanceIndex);
        GraphMaterial graph = LoadGraphMaterial(triangle.MaterialIndex);
        if (graph.volume)
        {
            if (uVolumeShadows != 0)
            {
                bool entering = dot(TransformInstanceNormal(instanceIndex, InterpolatedNormal(triangle, barycentric)),
                    direction) < 0.0;
                if (insideInstance >= 0)
                {
                    if (instanceIndex == insideInstance)
                    {
                        transmittance *= VolumeTransmittance(origin, direction, hitDistance, insideInstance,
                            insideMaterial, entryBoundary, true);
                        insideInstance = -1;
                    }
                }
                else if (entering)
                {
                    insideInstance = instanceIndex;
                    insideMaterial = triangle.MaterialIndex;
                    entryBoundary = true;
                }
                else
                    transmittance *= VolumeTransmittance(origin, direction, hitDistance, instanceIndex,
                        triangle.MaterialIndex, false, true);
            }
        }
        else if (SurfaceBlocksLight(triangle, instanceIndex, barycentric))
            return vec3(0.0);
        origin += direction * (hitDistance + RayEpsilon);
        remaining -= hitDistance + RayEpsilon;
        if (remaining <= RayEpsilon || max(transmittance.r, max(transmittance.g, transmittance.b)) < 0.003)
            return transmittance;
    }
    return vec3(0.0);
}

// In-scattered light from one randomly chosen light, scaled by the light count so the estimate is unbiased.
vec3 SampleVolumeLight(vec3 position, vec3 rayDirection, float anisotropy)
{
    int lightCount = uDirectionalLightCount + uPointLightCount;
    if (lightCount <= 0)
        return vec3(0.0);
    int index = min(int(RandomFloat() * float(lightCount)), lightCount - 1);
    vec3 irradiance;
    vec3 toLight;
    float maximumDistance = 3.402823e+38;
    bool castsShadows;
    if (index < uDirectionalLightCount)
    {
        int lightOffset = index * 3;
        vec4 direction = texelFetch(uDirectionalLights, TexelCoordinate(lightOffset, uDirectionalLightsWidth), 0);
        vec4 radiance = texelFetch(uDirectionalLights, TexelCoordinate(lightOffset + 1, uDirectionalLightsWidth), 0);
        vec4 flags = texelFetch(uDirectionalLights, TexelCoordinate(lightOffset + 2, uDirectionalLightsWidth), 0);
        toLight = SafeNormalize(direction.xyz, vec3(0.0, 1.0, 0.0));
        irradiance = radiance.rgb;
        castsShadows = flags.x > 0.5;
    }
    else
    {
        int lightOffset = (index - uDirectionalLightCount) * 4;
        vec4 lightPosition = texelFetch(uPointLights, TexelCoordinate(lightOffset, uPointLightsWidth), 0);
        vec4 lightDirection = texelFetch(uPointLights, TexelCoordinate(lightOffset + 1, uPointLightsWidth), 0);
        vec4 colorEnergy = texelFetch(uPointLights, TexelCoordinate(lightOffset + 2, uPointLightsWidth), 0);
        vec4 rangeSpot = texelFetch(uPointLights, TexelCoordinate(lightOffset + 3, uPointLightsWidth), 0);
        vec3 offset = lightPosition.xyz - position;
        float distanceSquared = dot(offset, offset);
        float range = rangeSpot.x;
        if (distanceSquared < 1e-8 || distanceSquared >= range * range)
            return vec3(0.0);
        float lightDistance = sqrt(distanceSquared);
        toLight = offset / lightDistance;
        float spot = 1.0;
        if (rangeSpot.z > -1.0)
        {
            float alignment = dot(SafeNormalize(lightDirection.xyz, vec3(0.0, -1.0, 0.0)), -toLight);
            if (alignment <= rangeSpot.z)
                return vec3(0.0);
            if (rangeSpot.y > rangeSpot.z)
            {
                float blend = clamp((alignment - rangeSpot.z) / (rangeSpot.y - rangeSpot.z), 0.0, 1.0);
                spot = blend * blend * (3.0 - 2.0 * blend);
            }
        }
        float rangeFalloff = clamp(1.0 - lightDistance / range, 0.0, 1.0);
        irradiance = colorEnergy.rgb * (colorEnergy.w * spot * rangeFalloff * rangeFalloff / distanceSquared);
        maximumDistance = lightDistance - RayEpsilon;
        castsShadows = rangeSpot.w > 0.5;
    }
    vec3 shadow = vec3(1.0);
    if (castsShadows)
        shadow = ShadowTransmittance(position, toLight, maximumDistance);
    return irradiance * shadow * (HenyeyGreenstein(dot(toLight, rayDirection), anisotropy) * float(lightCount));
}

// Marches one medium segment of a ray, adding in-scattered and emitted light and attenuating the throughput.
void AccumulateVolume(vec3 origin, vec3 direction, float segmentLength, int instanceIndex, int materialIndex,
    bool entryBoundary, bool exitBoundary, inout vec3 throughput, inout vec3 radiance)
{
    if (segmentLength <= 1e-5 || max(throughput.r, max(throughput.g, throughput.b)) <= 1e-4)
        return;
    GraphMaterial graph = LoadGraphMaterial(materialIndex);
    if (graph.row < 0)
        return;
    BindGraph(graph, materialIndex, instanceIndex);
    vec4 settings = readShaderGraphVolumeSettings();
    int steps = clamp(int(ceil(segmentLength / max(uVolumeStepSize, 0.01))), 1, max(uVolumeMaxSteps, 1));
    float stepLength = segmentLength / float(steps);
    float lightChance = clamp(float(uVolumeLightSamples) / float(steps), 0.0, 1.0);
    float jitter = RandomFloat();
    vec3 cachedCenter = vec3(1e30);
    VolumeSample volume = VolumeSample(0.0, vec3(0.0), vec3(1.0), vec3(0.0), 0.0, 0.0);
    for (int i = 0; i < steps; i++)
    {
        float t = (float(i) + jitter) * stepLength;
        vec3 point = origin + direction * t;
        float height;
        vec3 center = VolumeVoxelCenter(instanceIndex, settings, point, height);
        // Density is constant inside a voxel, so consecutive steps in one voxel share the graph evaluation.
        if (any(notEqual(center, cachedCenter)))
        {
            volume = EvaluateVolumeAt(graph, materialIndex, instanceIndex, center, direction);
            cachedCenter = center;
        }
        float factor = VolumeStepFactor(graph, settings, volume.softness, height, t, segmentLength,
            entryBoundary, exitBoundary);
        vec3 sigmaTotal = volume.sigmaTotal * factor;
        float sigmaScatter = volume.sigmaScatter * factor;
        vec3 source = volume.emission * factor;
        if (sigmaScatter > 1e-6)
        {
            vec3 incident = uAmbient;
            if (lightChance > 0.0 && RandomFloat() < lightChance)
                incident += SampleVolumeLight(point, direction, volume.anisotropy) / lightChance;
            source += sigmaScatter * volume.albedo * incident;
        }
        vec3 stepTransmittance = exp(-sigmaTotal * stepLength);
        vec3 weight = mix(vec3(stepLength), (vec3(1.0) - stepTransmittance) / max(sigmaTotal, vec3(1e-6)),
            step(vec3(1e-6), sigmaTotal));
        radiance += throughput * source * weight;
        throughput *= stepTransmittance;
        if (max(throughput.r, max(throughput.g, throughput.b)) < 0.003)
        {
            throughput = vec3(0.0);
            return;
        }
    }
}

vec3 EvaluateDirectLighting(vec3 position, vec3 normal)
{
    vec3 result = vec3(0.0);
    for (int i = 0; i < uDirectionalLightCount; i++)
    {
        int lightOffset = i * 3;
        DirectionalLight light;
        light.Direction = texelFetch(uDirectionalLights,
            TexelCoordinate(lightOffset, uDirectionalLightsWidth), 0);
        light.Radiance = texelFetch(uDirectionalLights,
            TexelCoordinate(lightOffset + 1, uDirectionalLightsWidth), 0);
        light.Flags = texelFetch(uDirectionalLights,
            TexelCoordinate(lightOffset + 2, uDirectionalLightsWidth), 0);
        vec3 direction = SafeNormalize(light.Direction.xyz, vec3(0.0, 1.0, 0.0));
        float cosine = max(0.0, dot(normal, direction));
        if (cosine <= 0.0)
            continue;
        vec3 shadow = vec3(1.0);
        if (light.Flags.x > 0.5)
        {
            shadow = ShadowTransmittance(position + normal * RayEpsilon, direction, 3.402823e+38);
            if (max(shadow.r, max(shadow.g, shadow.b)) <= 0.0)
                continue;
        }
        result += light.Radiance.rgb * (cosine / Pi) * shadow;
    }
    for (int i = 0; i < uPointLightCount; i++)
    {
        int lightOffset = i * 4;
        PointLight light;
        light.Position = texelFetch(uPointLights, TexelCoordinate(lightOffset, uPointLightsWidth), 0);
        light.Direction = texelFetch(uPointLights, TexelCoordinate(lightOffset + 1, uPointLightsWidth), 0);
        light.ColorEnergy = texelFetch(uPointLights, TexelCoordinate(lightOffset + 2, uPointLightsWidth), 0);
        light.RangeSpot = texelFetch(uPointLights, TexelCoordinate(lightOffset + 3, uPointLightsWidth), 0);
        vec3 toLight = light.Position.xyz - position;
        float distanceSquared = dot(toLight, toLight);
        float range = light.RangeSpot.x;
        if (distanceSquared < 1e-8 || distanceSquared >= range * range)
            continue;
        float distance = sqrt(distanceSquared);
        vec3 direction = toLight / distance;
        float cosine = max(0.0, dot(normal, direction));
        if (cosine <= 0.0)
            continue;
        float spot = 1.0;
        float outerCosine = light.RangeSpot.z;
        float innerCosine = light.RangeSpot.y;
        if (outerCosine > -1.0)
        {
            float alignment = dot(SafeNormalize(light.Direction.xyz, vec3(0.0, -1.0, 0.0)), -direction);
            if (alignment <= outerCosine)
                continue;
            if (innerCosine > outerCosine)
            {
                float t = clamp((alignment - outerCosine) / (innerCosine - outerCosine), 0.0, 1.0);
                spot = t * t * (3.0 - 2.0 * t);
            }
        }
        vec3 shadow = vec3(1.0);
        if (light.RangeSpot.w > 0.5)
        {
            shadow = ShadowTransmittance(position + normal * RayEpsilon, direction, distance - RayEpsilon);
            if (max(shadow.r, max(shadow.g, shadow.b)) <= 0.0)
                continue;
        }
        float rangeFalloff = clamp(1.0 - distance / range, 0.0, 1.0);
        float attenuation = rangeFalloff * rangeFalloff / distanceSquared;
        result += light.ColorEnergy.rgb * (light.ColorEnergy.w * cosine * spot * attenuation / Pi) * shadow;
    }
    return result;
}

vec3 CosineHemisphere(vec3 normal)
{
    float r1 = RandomFloat();
    float r2 = RandomFloat();
    float radius = sqrt(r1);
    float angle = 2.0 * Pi * r2;
    vec3 tangent = SafeNormalize(abs(normal.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), normal) :
        cross(vec3(1.0, 0.0, 0.0), normal), vec3(1.0, 0.0, 0.0));
    vec3 bitangent = cross(normal, tangent);
    return SafeNormalize(tangent * (radius * cos(angle)) + bitangent * (radius * sin(angle)) +
        normal * sqrt(1.0 - r1), normal);
}

vec3 RandomInUnitSphere()
{
    float z = RandomFloat() * 2.0 - 1.0;
    float angle = RandomFloat() * 2.0 * Pi;
    float radius = pow(RandomFloat(), 1.0 / 3.0) * sqrt(1.0 - z * z);
    return vec3(radius * cos(angle), radius * sin(angle), z);
}

// coverage is the opacity of the pixel for a transparent background: 1 once a surface is hit, otherwise how much
// of the light the fog along the ray absorbed.
vec3 Trace(vec3 origin, vec3 direction, out bool primaryHit, out float coverage)
{
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    int transparentLayers = 0;
    int insideInstance = -1;
    int insideMaterial = -1;
    bool entryBoundary = false;
    primaryHit = false;
    coverage = 0.0;
    for (int bounce = 0; bounce <= uMaxBounces;)
    {
        int triangleIndex;
        int instanceIndex;
        float distance;
        vec3 barycentric;
        if (!IntersectScene(origin, direction, 3.402823e+38, triangleIndex, instanceIndex, distance, barycentric))
        {
            if (uTransparentBackground != 0 && !primaryHit)
            {
                coverage = clamp(1.0 - dot(throughput, vec3(1.0 / 3.0)), 0.0, 1.0);
                return radiance;
            }
            return radiance + throughput * uEnvironment;
        }

        Triangle triangle = LoadTriangle(triangleIndex, instanceIndex);
        GraphMaterial graph = LoadGraphMaterial(triangle.MaterialIndex);
        vec3 normal = TransformInstanceNormal(instanceIndex, InterpolatedNormal(triangle, barycentric));

        // Inside a fog volume: integrate the medium up to this hit first.
        if (insideInstance >= 0)
        {
            AccumulateVolume(origin, direction, distance, insideInstance, insideMaterial, entryBoundary,
                graph.volume && instanceIndex == insideInstance, throughput, radiance);
            if (max(throughput.r, max(throughput.g, throughput.b)) <= 0.0)
            {
                if (!primaryHit)
                    coverage = 1.0;
                return radiance;
            }
        }
        if (graph.volume)
        {
            if (insideInstance < 0)
            {
                if (dot(normal, direction) < 0.0)
                {
                    insideInstance = instanceIndex;
                    insideMaterial = triangle.MaterialIndex;
                    entryBoundary = true;
                }
                else
                {
                    // The ray started inside this volume; it ends at the surface just hit.
                    AccumulateVolume(origin, direction, distance, instanceIndex, triangle.MaterialIndex, false, true,
                        throughput, radiance);
                }
            }
            else if (instanceIndex == insideInstance)
                insideInstance = -1;
            if (++transparentLayers > 32)
                return radiance + throughput * uEnvironment;
            origin += direction * (distance + RayEpsilon);
            continue;
        }

        vec2 uv = triangle.UvAB.xy * barycentric.x + triangle.UvAB.zw * barycentric.y + triangle.UvC.xy * barycentric.z;
        vec4 surface = SampleAlbedo(triangle, uv);
        bool hasGraph = graph.row >= 0;
        bool backfacing = dot(normal, direction) > 0.0;
        vec3 facingNormal = backfacing ? -normal : normal;
        vec3 shadingNormal = facingNormal;
        NodeSurface graphSurface;
        if (hasGraph)
        {
            vec3 localPosition = triangle.A.xyz * barycentric.x + triangle.B.xyz * barycentric.y +
                triangle.C.xyz * barycentric.z;
            graphSurface = EvaluateGraphHit(graph, triangle.MaterialIndex, instanceIndex, TransformUv(triangle, uv),
                localPosition, facingNormal, -direction, backfacing, true, shadingNormal);
            surface.a *= graphSurface.alpha;
        }
        bool clipped = triangle.Flags.x > 0.5 && surface.a < triangle.Material.z;
        bool transparent = triangle.Flags.x > 0.5 ? clipped :
            surface.a < 1.0 && RandomFloat() > surface.a;
        if (transparent)
        {
            if (++transparentLayers > 32)
                return radiance + throughput * uEnvironment;
            origin += direction * (distance + RayEpsilon);
            continue;
        }
        transparentLayers = 0;
        if (bounce == 0)
        {
            primaryHit = true;
            coverage = 1.0;
        }

        normal = shadingNormal;
        vec3 position = origin + direction * distance;
        float metallic = clamp(triangle.Material.x, 0.0, 1.0);
        float roughness = clamp(triangle.Material.y, 0.0, 1.0);
        float transmission = 0.0;
        float ior = 1.45;
        vec3 albedo = surface.rgb;
        vec3 emission = triangle.Flags.z > 0.5 && bounce == 0 ? vec3(0.0) : SampleEmission(triangle, uv);
        if (hasGraph)
        {
            // A graph replaces the surface shading, like the viewport's custom shader.
            albedo = SrgbToLinear3(graphSurface.color);
            metallic = graphSurface.metallic;
            roughness = graphSurface.roughness;
            transmission = graphSurface.transmission * (1.0 - metallic);
            ior = graphSurface.ior;
            emission = triangle.Flags.z > 0.5 && bounce == 0 ? vec3(0.0) : GraphEmissionToLinear(graphSurface.emission);
        }
        if (triangle.Flags.y > 0.5)
            return radiance + throughput * (emission + albedo);
        radiance += throughput * (emission + albedo * (1.0 - metallic) * (1.0 - transmission) *
            (uAmbient + EvaluateDirectLighting(position, normal)));
        if (bounce == uMaxBounces)
            return radiance;

        vec3 nextDirection;
        bool refracted = false;
        if (transmission > 0.0 && RandomFloat() < transmission)
        {
            // Glass: reflect with the Fresnel probability, otherwise refract through the surface.
            float fresnel = graphFresnelDielectric(dot(-direction, normal), backfacing ? 1.0 / ior : ior);
            vec3 refractedDirection = refract(direction, normal, backfacing ? ior : 1.0 / ior);
            if (dot(refractedDirection, refractedDirection) <= 0.0 || RandomFloat() < fresnel)
                nextDirection = reflect(direction, normal);
            else
            {
                nextDirection = refractedDirection;
                refracted = true;
            }
            if (roughness > 0.001)
                nextDirection = SafeNormalize(nextDirection + RandomInUnitSphere() * roughness * roughness,
                    refracted ? -normal : normal);
            throughput *= albedo;
        }
        else if (metallic > 0.0 && RandomFloat() < metallic)
        {
            nextDirection = reflect(direction, normal);
            if (roughness > 0.001)
                nextDirection = SafeNormalize(nextDirection + RandomInUnitSphere() * roughness * roughness, normal);
            throughput *= albedo;
        }
        else
        {
            nextDirection = CosineHemisphere(normal);
            throughput *= albedo;
        }
        if (bounce >= 3)
        {
            float survival = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
            if (RandomFloat() > survival)
                return radiance;
            throughput /= survival;
        }
        origin = refracted ? position - normal * RayEpsilon : position + normal * RayEpsilon;
        direction = SafeNormalize(nextDirection, refracted ? -normal : normal);
        bounce++;
    }
    return radiance;
}

float LinearToSrgb(float value)
{
    return value <= 0.0031308 ? value * 12.92 : 1.055 * pow(value, 1.0 / 2.4) - 0.055;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) + uTileOrigin;
    if (pixel.x >= uWidth || pixel.y >= uHeight)
        return;

    RandomState = uint(uSeed) * 747796405u + uint(uSampleIndex) * 2891336453u +
        uint(pixel.y) * 277803737u + uint(pixel.x);
    if (RandomState == 0u)
        RandomState = 0xA341316Cu;
    float aspect = float(uWidth) / float(uHeight);
    float halfHeight = tan(uFov * 0.5);
    float px = ((float(pixel.x) + RandomFloat()) / float(uWidth) * 2.0 - 1.0) * aspect * halfHeight;
    float py = ((float(pixel.y) + RandomFloat()) / float(uHeight) * 2.0 - 1.0) * halfHeight;
    vec3 direction = SafeNormalize(uCameraForward + uCameraRight * px + uCameraUp * py, uCameraForward);
    bool primaryHit;
    float coverage;
    vec3 sampleRadiance = Trace(uCameraPosition, direction, primaryHit, coverage);
    vec4 sampleContribution = vec4(sampleRadiance, 1.0);
    if (uTransparentBackground != 0 && !primaryHit)
        sampleContribution = vec4(sampleRadiance, coverage);
    vec4 accumulated = uSampleIndex == 0 ? sampleContribution :
        imageLoad(AccumulationImage, pixel) + sampleContribution;
    imageStore(AccumulationImage, pixel, accumulated);
    float coveredSamples = uTransparentBackground != 0 ? accumulated.a : float(uSampleIndex + 1);
    vec3 averageRadiance = coveredSamples > 0.0 ? accumulated.rgb / coveredSamples : vec3(0.0);
    vec3 linearColor = max(vec3(0.0), averageRadiance * uExposure);
    linearColor = linearColor / (vec3(1.0) + linearColor);
    vec3 displayColor = vec3(LinearToSrgb(linearColor.r), LinearToSrgb(linearColor.g), LinearToSrgb(linearColor.b));
    float alpha = uTransparentBackground != 0 ? accumulated.a / float(uSampleIndex + 1) : 1.0;
    imageStore(OutputImage, pixel, vec4(displayColor, alpha));
}
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MineImatorSimplyRemade.core.ui.Dock.ViewportView"
             Focusable="True">
    <Grid RowDefinitions="Auto,*" Background="#1A1A1A">
        <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" Spacing="6" Margin="4" Grid.Row="0">
            <Button x:Name="SpawnMenuButton" Width="22" Height="22" Padding="0"
                    Background="Transparent" BorderBrush="Transparent" ToolTip.Tip="Spawn object">
                <Image x:Name="BenchIcon" Width="22" Height="22" />
                <Button.Styles>
                    <Style Selector="Button /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </Style>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="Button:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </Button.Styles>
            </Button>
            <ComboBox x:Name="CameraDropdown" MinWidth="140" SelectedIndex="0" />
            <ComboBox x:Name="RenderModeDropdown" MinWidth="110" SelectedIndex="2">
                <ComboBoxItem>Wireframe</ComboBoxItem>
                <ComboBoxItem>Flat</ComboBoxItem>
                <ComboBoxItem>Shaded</ComboBoxItem>
                <ComboBoxItem>Rendered</ComboBoxItem>
            </ComboBox>
            <ToggleButton x:Name="OverlaysToggle" Content="Overlays" IsChecked="True" />
            <TextBlock x:Name="FpsText" VerticalAlignment="Center" Foreground="#888" Margin="12,0,0,0" />
        </StackPanel>

        <Border x:Name="ViewportHost" Grid.Row="1" Background="Black" ClipToBounds="True">
            <Grid>
                <Image x:Name="SceneImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Panel x:Name="SceneImageOverlay" IsHitTestVisible="False" />
                <TextBlock x:Name="ViewportStatusText"
                           Text="Waiting for viewport surface..."
                           Foreground="#FFB4AB"
                           Background="#B0000000"
                           Margin="12"
                           Padding="8"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

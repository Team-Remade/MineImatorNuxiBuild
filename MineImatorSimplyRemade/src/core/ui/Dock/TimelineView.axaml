<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:MineImatorSimplyRemade.core.ui.Dock"
             x:Class="MineImatorSimplyRemade.core.ui.Dock.TimelineView">
    <Grid RowDefinitions="Auto,*" Background="#181818">
        <!-- Transport bar -->
        <DockPanel Grid.Row="0" Margin="6,4" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="3">
                <Button x:Name="JumpStartButton" Padding="4,1" ToolTip.Tip="Jump to start"><Image x:Name="JumpStartIcon" Width="16" Height="16" /></Button>
                <Button x:Name="StepBackButton" Padding="4,1" ToolTip.Tip="Step back one frame"><Image x:Name="StepBackIcon" Width="16" Height="16" /></Button>
                <Button x:Name="PlayPauseButton" Padding="4,1" ToolTip.Tip="Play / pause (Space)"><Image x:Name="PlayPauseIcon" Width="16" Height="16" /></Button>
                <Button x:Name="StopButton" Padding="4,1" ToolTip.Tip="Stop and rewind"><Image x:Name="StopIcon" Width="16" Height="16" /></Button>
                <Button x:Name="StepForwardButton" Padding="4,1" ToolTip.Tip="Step forward one frame"><Image x:Name="StepForwardIcon" Width="16" Height="16" /></Button>
                <Button x:Name="JumpEndButton" Padding="4,1" ToolTip.Tip="Jump to last keyframe"><Image x:Name="JumpEndIcon" Width="16" Height="16" /></Button>

                <Rectangle Width="1" Fill="#333" Margin="4,2" />

                <ToggleButton x:Name="LoopToggle" Padding="4,1"
                              ToolTip.Tip="Loop playback when reaching the end"><Image x:Name="LoopIcon" Width="16" Height="16" /></ToggleButton>
                <ToggleButton x:Name="GhostToggle" Padding="4,1"
                              ToolTip.Tip="Ghost mode: hide ghosted tracks"><Image x:Name="GhostIcon" Width="16" Height="16" /></ToggleButton>
                <ToggleButton x:Name="RecordToggle" Padding="4,1"
                              ToolTip.Tip="Auto-keyframe: record property changes as keyframes">
                    <Image x:Name="AutoKeyIcon" Width="16" Height="16" />
                    <ToggleButton.Styles>
                        <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                            <Setter Property="Foreground" Value="#E53935" />
                        </Style>
                    </ToggleButton.Styles>
                </ToggleButton>

                <Rectangle Width="1" Fill="#333" Margin="4,2" />

                <TextBlock Text="FPS" VerticalAlignment="Center" Foreground="#AAA" Margin="2,0,0,0" />
                <NumericUpDown x:Name="FpsBox" Minimum="1" Maximum="120" Increment="1"
                               Value="30" Width="110" FormatString="0" />
                <TextBlock Text="Frames" VerticalAlignment="Center" Foreground="#AAA" Margin="6,0,0,0" />
                <NumericUpDown x:Name="FramesBox" Minimum="10" Maximum="100000" Increment="10"
                               Value="300" Width="130" FormatString="0" />

                <Rectangle Width="1" Fill="#333" Margin="4,2" />

                <Button x:Name="ZoomOutButton" Content="-" Padding="8,1" ToolTip.Tip="Zoom out (Ctrl + mouse wheel)" />
                <TextBlock x:Name="ZoomLabel" Text="8 px/f" VerticalAlignment="Center" Foreground="#777" />
                <Button x:Name="ZoomInButton" Content="+" Padding="8,1" ToolTip.Tip="Zoom in (Ctrl + mouse wheel)" />
            </StackPanel>

            <TextBlock x:Name="FrameLabel" DockPanel.Dock="Right"
                       Text="Frame: 0  (0.00s)" VerticalAlignment="Center" Foreground="#DDD" />
        </DockPanel>

        <!-- Ruler + track area (custom drawn) -->
        <dock:TimelineCanvas x:Name="Canvas" Grid.Row="1" />
    </Grid>
</UserControl>

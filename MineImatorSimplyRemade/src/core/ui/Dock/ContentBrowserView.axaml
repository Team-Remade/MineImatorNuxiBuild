<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MineImatorSimplyRemade.core.ui.Dock.ContentBrowserView">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="#202020" Margin="4">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
            <TextBlock x:Name="ProjectNameText" Foreground="#AAA" VerticalAlignment="Center" />
            <TextBlock x:Name="ProjectFolderText" Foreground="#666" VerticalAlignment="Center" />
        </StackPanel>

        <Button x:Name="ImportButton" Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,4"
                Content="Import Asset">
            <Button.Flyout>
                <MenuFlyout>
                    <MenuItem x:Name="ImportModelItem" Header="Model" />
                    <MenuItem x:Name="ImportImageItem" Header="Image" />
                    <MenuItem x:Name="ImportSoundItem" Header="Sound" />
                    <Separator />
                    <MenuItem x:Name="ImportResourcePackItem" Header="Resource Pack (.zip)" />
                    <MenuItem x:Name="ImportResourcePackFolderItem" Header="Resource Pack Folder" />
                </MenuFlyout>
            </Button.Flyout>
        </Button>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBox x:Name="SearchBox" Grid.Column="0" Watermark="Search assets..." Margin="0,0,6,0" />
            <ComboBox x:Name="TypeFilterCombo" Grid.Column="1" MinWidth="140" SelectedIndex="0">
                <ComboBoxItem>All types</ComboBoxItem>
                <ComboBoxItem>Unknown</ComboBoxItem>
                <ComboBoxItem>Model</ComboBoxItem>
                <ComboBoxItem>Image</ComboBoxItem>
                <ComboBoxItem>Sound</ComboBoxItem>
                <ComboBoxItem>Other</ComboBoxItem>
            </ComboBox>
        </Grid>

        <Border Grid.Row="3" BorderBrush="#3A3A3A" BorderThickness="1">
            <Grid>
                <ListBox x:Name="AssetList" Background="Transparent" />
                <TextBlock x:Name="EmptyLabel" Foreground="#777"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="False" Text="No assets to display." />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Spacing="4" Margin="0,4,0,0">
            <Button x:Name="AddToTimelineButton" HorizontalAlignment="Stretch"
                    Content="Add Selected Sound to Timeline" IsVisible="False" />
            <Button x:Name="SpawnButton" HorizontalAlignment="Stretch"
                    Content="Spawn Selected Asset" />
        </StackPanel>
    </Grid>
</UserControl>

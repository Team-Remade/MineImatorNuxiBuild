<window:WindowBase xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:window="using:MineImatorSimplyRemade.core.window"
                    xmlns:panels="using:MineImatorSimplyRemade.core.ui.Panels"
                    xmlns:dock="using:Dock.Avalonia.Controls"
                    x:Class="MineImatorSimplyRemade.core.window.windows.MainWindow"
                    Title="Mine Imator Nuxi"
                    WindowStartupLocation="CenterScreen"
                    Width="1600" Height="900">
    <Grid RowDefinitions="Auto,*,Auto">
        <panels:Menubar x:Name="MenubarControl" Grid.Row="0" />

        <!-- The default editor dockspace (Viewport / Scene Tree / Properties /
             Timeline / Content Browser) - see AppDockFactory for the layout
             structure, which reproduces the old ImGui version's dock split
             proportions exactly. Individual panels currently show
             PlaceholderPanelView until their own porting pass replaces the
             corresponding tool's Content. The project home screen overlay and
             modal popups (Render Output, Update, Resource Pack Import, New/
             Save-As dialogs) are still separate follow-up items. -->
        <dock:DockControl x:Name="MainDockControl" Grid.Row="1" />

        <Border x:Name="ToastBorder" Grid.Row="2" Padding="8,4" Background="#181818" IsVisible="False">
            <TextBlock x:Name="ToastText" />
        </Border>
    </Grid>
</window:WindowBase>

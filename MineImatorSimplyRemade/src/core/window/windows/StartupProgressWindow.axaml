<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MineImatorSimplyRemade.core.window.windows.StartupProgressWindow"
        Title="Preparing Mine Imator Simply Remade"
        Width="560" Height="210"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C21">
    <Grid Margin="22,20">
        <StackPanel Spacing="0">
            <TextBlock x:Name="TitleText" Foreground="#EBBC4F" FontSize="16" FontWeight="Bold" />
            <TextBlock x:Name="StepLabelText" Foreground="#888C99" Margin="0,2,0,8" />
            <Separator Background="#33363E" Height="1" Margin="0,0,0,6" />
            <TextBlock x:Name="PhaseText" TextWrapping="Wrap" Margin="0,6,0,10" />
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="16" Margin="0,0,0,10" />
            <TextBlock x:Name="WorkingText" Margin="0,0,0,0" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText" Foreground="#B3BDCC" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="False" />
        </StackPanel>

        <Image x:Name="GifImage"
               Width="84" Height="84"
               Stretch="Uniform"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom" />
    </Grid>
</Window>
